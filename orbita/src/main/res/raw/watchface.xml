<?xml version="1.0" encoding="utf-8"?>
<!--
  NVC Orbita, Watch Face Format v2 (Wear OS 5, API 34). GENERATED by scripts/gen_orbita_xml.py.
  Design: docs/superpowers/specs/2026-11-26-orbita-design.md. Coordinates: watch px (466x466).
  Art: scripts/render_3d.sh 256 orbita (Blender) + scripts/sync_face.sh orbita; resources orb_.
  WFF names checked in docs/pruebas/07-orbita.md (STEP_COUNT, STEP_PERCENT, HEART_RATE, TextCircular,
  tintColor with a ColorConfiguration).
-->
<WatchFace width="466" height="466" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:37" />

    <UserConfigurations>
        <ColorConfiguration id="colorAnillo" displayName="color_anillo" defaultValue="0">
            <ColorOption id="0" displayName="verde" colors="#ff559254" />
            <ColorOption id="1" displayName="naranja" colors="#ffdc6e0b" />
            <ColorOption id="2" displayName="rojo" colors="#ffb10d0b" />
            <ColorOption id="3" displayName="amarillo" colors="#ffe7bb0f" />
            <ColorOption id="4" displayName="azul" colors="#ff0d5aac" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- ===== Dial (Blender, sectors in neutral silver) and Always-On dial ===== -->
        <PartImage name="fondo" x="0" y="0" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="orb_bg_3d" />
        </PartImage>
        <PartImage name="esfera_ambiente" x="0" y="0" width="466" height="466" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Image resource="orb_ambient_dial" />
        </PartImage>

        <!-- ===== Coloured sectors: white anodised layer tinted with the colour chosen in Personalizar ===== -->
        <PartImage name="anillo" x="0" y="0" width="466" height="466" tintColor="[CONFIGURATION.colorAnillo]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="orb_ring_tint" />
        </PartImage>

        <!-- ===== Steps progress marker: -14 deg (0 %) .. 54 deg (100 % of the daily goal) ===== -->
        <PartImage name="marca_pasos" x="0" y="0" width="466" height="466" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="-14 + 68 * clamp([STEP_PERCENT], 0, 100) / 100" />
            <Image resource="orb_step_marker" />
        </PartImage>

        <!-- ===== Band texts: steps at 10:30 (shoe printed in the dial), battery at 7, pulse at 5 ===== -->
        <PartText name="pasos" x="0" y="0" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TextCircular centerX="233" centerY="233" width="426" height="426" startAngle="-43" endAngle="-3"
                direction="CLOCKWISE" align="START">
                <Font family="barlow_condensed_semibold" size="28" color="#ff28282a">
                    <Template>%s<Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </TextCircular>
        </PartText>
        <Group name="bateria_grupo" x="0" y="0" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Condition>
                <Expressions>
                    <Expression name="baja"><![CDATA[[BATTERY_IS_LOW]]]></Expression>
                </Expressions>
                <Compare expression="baja">
                    <PartImage name="pila_baja" x="0" y="0" width="466" height="466">
                        
                        <Image resource="orb_icon_battery_low" />
                    </PartImage>
                    <PartText name="bateria_baja" x="0" y="0" width="466" height="466">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <TextCircular centerX="233" centerY="233" width="426" height="426" startAngle="214" endAngle="182"
                            direction="COUNTER_CLOCKWISE" align="START">
                            <Font family="barlow_condensed_semibold" size="28" color="#ffe5483c">
                                <Template>%s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                            </Font>
                        </TextCircular>
                    </PartText>
                </Compare>
                <Default>
                    <PartImage name="pila" x="0" y="0" width="466" height="466">
                        
                        <Image resource="orb_icon_battery" />
                    </PartImage>
                    <PartText name="bateria" x="0" y="0" width="466" height="466">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <TextCircular centerX="233" centerY="233" width="426" height="426" startAngle="214" endAngle="182"
                            direction="COUNTER_CLOCKWISE" align="START">
                            <Font family="barlow_condensed_semibold" size="28" color="#ff28282a">
                                <Template>%s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                            </Font>
                        </TextCircular>
                    </PartText>
                </Default>
            </Condition>
        </Group>
        <!-- heart rate: 0 means no reading (watch off the wrist): dashes, never "0 BPM" -->
        <Group name="pulso_grupo" x="0" y="0" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Condition>
                <Expressions>
                    <Expression name="sin_lectura"><![CDATA[round([HEART_RATE]) == 0]]></Expression>
                </Expressions>
                <Compare expression="sin_lectura">
                    <PartText name="pulso_sin" x="0" y="0" width="466" height="466">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <TextCircular centerX="233" centerY="233" width="426" height="426" startAngle="171" endAngle="127"
                            direction="COUNTER_CLOCKWISE" align="CENTER">
                            <Font family="barlow_condensed_semibold" size="28" color="#ff28282a">
                                -- BPM
                            </Font>
                        </TextCircular>
                    </PartText>
                </Compare>
                <Default>
                    <PartText name="pulso" x="0" y="0" width="466" height="466">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <TextCircular centerX="233" centerY="233" width="426" height="426" startAngle="171" endAngle="127"
                            direction="COUNTER_CLOCKWISE" align="CENTER">
                            <Font family="barlow_condensed_semibold" size="28" color="#ff28282a">
                                <Template>%s BPM<Parameter expression="round([HEART_RATE])" /></Template>
                            </Font>
                        </TextCircular>
                    </PartText>
                </Default>
            </Condition>
        </Group>
        <!-- end heart rate -->

        <!-- ===== One-tap workout: invisible slot over the steps; opens what the user assigns ===== -->
        <ComplicationSlot slotId="10" displayName="Entreno" x="62" y="22"
            width="110" height="64" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE SHORT_TEXT EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
                primaryProvider="com.heytap.wearable.sports/com.heytap.wearable.sports.complications.SportFreeTrainingComplicationService"
                primaryProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingBox x="0" y="0" width="110" height="64" />
            <Complication type="MONOCHROMATIC_IMAGE" />
            <Complication type="SMALL_IMAGE" />
            <Complication type="SHORT_TEXT" />
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- ===== Glucose: value only, 48 px, in the sub-dial at 6 (disc r 46 round (233, 367)).
             Colour follows the number shown: < 70 red, > 180 amber, otherwise white. Visible in Always-On. ===== -->
        <ComplicationSlot slotId="1" displayName="Glucosa" x="187" y="321" width="92"
            height="92" supportedTypes="RANGED_VALUE EMPTY">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
                primaryProvider="com.gluroo.app/com.gluroo.app.dev.providers.GlucoseRangeDataProviderService"
                primaryProviderType="RANGED_VALUE" />
            <BoundingOval x="0" y="0" width="92" height="92" />
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="hipo"><![CDATA[round([COMPLICATION.RANGED_VALUE_VALUE]) < 70]]></Expression>
                        <Expression name="hiper"><![CDATA[round([COMPLICATION.RANGED_VALUE_VALUE]) > 180]]></Expression>
                    </Expressions>
                    <Compare expression="hipo">
                        <PartText x="0" y="18" width="92" height="56">
                            <Text align="CENTER">
                                <Font family="barlow_condensed_semibold" size="48" color="#ffe5483c"><Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template></Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="hiper">
                        <PartText x="0" y="18" width="92" height="56">
                            <Text align="CENTER">
                                <Font family="barlow_condensed_semibold" size="48" color="#ffe3a63a"><Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template></Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="18" width="92" height="56">
                            <Text align="CENTER">
                                <Font family="barlow_condensed_semibold" size="48" color="#fff0f0ec"><Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template></Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <!-- No data: two grey dashes; never a made-up number -->
            <Complication type="EMPTY">
                <PartText x="0" y="18" width="92" height="56">
                    <Text align="CENTER">
                        <Font family="barlow_condensed_semibold" size="48" color="#ff8c8a84">--</Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ===== Hands (Blender). Shadows: second clock shifted (2, 3) px. Ambient: dim silhouettes. ===== -->
        <AnalogClock x="2" y="3" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <HourHand resource="orb_hand3d_hour_shadow" x="217" y="84" width="32" height="172" pivotX="0.5" pivotY="0.869186" />
            <MinuteHand resource="orb_hand3d_minute_shadow" x="218" y="28" width="30" height="228" pivotX="0.5" pivotY="0.901316" />
            <SecondHand resource="orb_hand3d_second_shadow" x="226" y="9" width="14" height="272" pivotX="0.5" pivotY="0.825368" />
        </AnalogClock>
        <AnalogClock x="0" y="0" width="466" height="466">
            <HourHand resource="orb_hand3d_hour" x="217" y="84" width="32" height="172" pivotX="0.5" pivotY="0.869186">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </HourHand>
            <HourHand resource="orb_hand3d_hour_aod" x="217" y="84" width="32" height="172" pivotX="0.5" pivotY="0.869186" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
            </HourHand>
            <MinuteHand resource="orb_hand3d_minute" x="218" y="28" width="30" height="228" pivotX="0.5" pivotY="0.901316">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </MinuteHand>
            <MinuteHand resource="orb_hand3d_minute_aod" x="218" y="28" width="30" height="228" pivotX="0.5" pivotY="0.901316" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
            </MinuteHand>
            <SecondHand resource="orb_hand3d_second" x="226" y="9" width="14" height="272" pivotX="0.5" pivotY="0.825368">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </SecondHand>
        </AnalogClock>
        <PartImage name="tapa_sombra" x="220" y="221" width="28" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="orb_hand3d_cap_shadow" />
        </PartImage>
        <PartImage name="tapa" x="219" y="219" width="28" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="orb_hand3d_cap" />
        </PartImage>

    </Scene>
</WatchFace>
