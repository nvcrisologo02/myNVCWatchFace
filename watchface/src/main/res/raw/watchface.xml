<?xml version="1.0" encoding="utf-8"?>
<!--
  NVC watch face, Watch Face Format v2 (Wear OS 5, API 34). Design: docs/superpowers/specs/2026-11-22-nvc-watchface-design.md
  Coordinates are watch pixels (466x466). Bitmaps are 2x and scaled down.

  WFF references used (checked against developer.android.com and the google/watchface v2 schema):
  - data sources DAY, DAY_OF_WEEK_S, BATTERY_PERCENT, BATTERY_IS_LOW:
      developer.android.com/training/wearables/wff/common/attributes/source-type
  - COMPLICATION.TEXT / TITLE / RANGED_VALUE_VALUE / MONOCHROMATIC_IMAGE / SMALL_IMAGE:
      developer.android.com/reference/wear-os/wff/complication/complication
  - expressions (clamp, ternary, subText, textLength): .../wff/common/attributes/arithmetic-expression
  - Condition/Compare/Default: .../wff/transform/content ; Transform: .../wff/transform
  - Variant mode="AMBIENT": .../wff/common/variant/variant ; AnalogClock/hands: .../wff/clock/analog-clock
  In v2 a Stroke colour is not transformable (only from v4), so range colours use Condition branches.
-->
<WatchFace width="466" height="466" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#ff000000">

        <!-- ===== Dial: generated background (active) and ambient dial ===== -->
        <PartImage name="fondo" x="0" y="0" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="bg_3d" />  <!-- Blender render (scripts/render_3d.sh); 2D version: bg_bajo -->
        </PartImage>
        <PartImage name="esfera_ambiente" x="0" y="0" width="466" height="466" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Image resource="ambient_dial" />
        </PartImage>

        <!-- ===== Date window at 3 o'clock: hole centred on (371, 233), 66x28 ===== -->
        <Group name="fecha" x="338" y="219" width="66" height="28">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <PartText x="2" y="0" width="36" height="28">
                <Text align="CENTER">
                    <Font family="barlow_condensed_semibold" size="20" color="#ffc9a86a">
                        <Upper><Template>%s<Parameter expression="subText([DAY_OF_WEEK_S], 0, 3)" /></Template></Upper>
                    </Font>
                </Text>
            </PartText>
            <PartText x="36" y="0" width="28" height="28">
                <Text align="CENTER">
                    <Font family="barlow_condensed_semibold" size="20" color="#ffefede7">
                        <Template>%s<Parameter expression="[DAY]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- ===== Battery window at 9 o'clock: hole centred on (95, 233), 66x28 ===== -->
        <Group name="bateria" x="62" y="219" width="66" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Condition>
                <Expressions>
                    <Expression name="baja"><![CDATA[[BATTERY_IS_LOW]]]></Expression>
                </Expressions>
                <Compare expression="baja">
                    <Group name="bateria_baja" x="0" y="0" width="66" height="28">
                        <PartDraw x="5" y="7" width="25" height="14">
                            <Rectangle x="0.5" y="0.5" width="20" height="12">
                                <Stroke color="#ffe5483c" thickness="1" />
                            </Rectangle>
                            <Rectangle x="21" y="4" width="2.5" height="5">
                                <Fill color="#ffe5483c" />
                            </Rectangle>
                            <Rectangle x="2" y="2" width="17" height="9">
                                <Transform target="width" value="clamp([BATTERY_PERCENT], 0, 100) * 0.17" />
                                <Fill color="#ffe5483c" />
                            </Rectangle>
                        </PartDraw>
                        <PartText x="29" y="0" width="37" height="28">
                            <Text align="CENTER">
                                <Font family="barlow_condensed_semibold" size="20" color="#ffe5483c">
                                    <Template>%s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Group>
                </Compare>
                <Default>
                    <Group name="bateria_normal" x="0" y="0" width="66" height="28">
                        <PartDraw x="5" y="7" width="25" height="14">
                            <Rectangle x="0.5" y="0.5" width="20" height="12">
                                <Stroke color="#ffc9a86a" thickness="1" />
                            </Rectangle>
                            <Rectangle x="21" y="4" width="2.5" height="5">
                                <Fill color="#ffc9a86a" />
                            </Rectangle>
                            <Rectangle x="2" y="2" width="17" height="9">
                                <Transform target="width" value="clamp([BATTERY_PERCENT], 0, 100) * 0.17" />
                                <Fill color="#ffc9a86a" />
                            </Rectangle>
                        </PartDraw>
                        <PartText x="29" y="0" width="37" height="28">
                            <Text align="CENTER">
                                <Font family="barlow_condensed_semibold" size="20" color="#ffefede7">
                                    <Template>%s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Group>
                </Default>
            </Condition>
        </Group>

        <!-- ===== Left sub-dial: activity, centre (151, 319), r 41 ===== -->
        <ComplicationSlot slotId="10" displayName="Actividad" x="110" y="278" width="82" height="82"
            supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE SHORT_TEXT EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
                primaryProvider="com.heytap.wearable.sports/com.heytap.wearable.sports.complications.SportFreeTrainingComplicationService"
                primaryProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingOval x="0" y="0" width="82" height="82" />
            <!-- icon pushed left, away from the overlap with the glucose dial -->
            <Complication type="MONOCHROMATIC_IMAGE">
                <!-- OHealth sends its icon already coloured green; tinting only darkened it on the
                     watch, so the hue is rotated from green to the gold of the dial (115°, checked on the watch: 275° gives blue, 85° yellow-green). -->
                <PartImage x="3" y="9" width="64" height="64">
                    <ImageFilters><HsbFilter hueRotate="115" saturate="0.7" /></ImageFilters>
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="3" y="9" width="64" height="64">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartImage x="22" y="14" width="24" height="24" tintColor="#ffc9a86a">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="5" y="40" width="60" height="22">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="barlow_condensed_medium" size="18" color="#ffefede7">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- ===== Right sub-dial: weather, centre (315, 319), r 41 ===== -->
        <ComplicationSlot slotId="11" displayName="Tiempo" x="274" y="278" width="82" height="82"
            supportedTypes="SHORT_TEXT EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
                primaryProvider="com.heytap.wearable.weather/com.heytap.wearable.weather.complication.wearos.WeatherProviderService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="82" height="82" />
            <!-- icon and temperature pushed right, away from the overlap -->
            <Complication type="SHORT_TEXT">
                <PartImage x="30" y="6" width="38" height="38" tintColor="#ffc9a86a">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="12" y="40" width="68" height="34">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="barlow_condensed_medium" size="28" color="#ffefede7">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- ===== Central sub-dial: glucose, centre (233, 345), r 50. Declared after the side
             dials so it is drawn on top of them (design §5.3). Ring r 43.5, stroke 3. =====
             Range colours (design §5.5): < 70 red, > 180 amber, otherwise gold. The ring is computed
             from 70-180 mg/dL, NOT from the provider's min/max (Gluroo sends 20-400). Out of range
             the ring is drawn full in the warning colour. -->
        <ComplicationSlot slotId="1" displayName="Glucosa" x="183" y="295" width="100" height="100"
            supportedTypes="RANGED_VALUE EMPTY">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
                primaryProvider="com.gluroo.app/com.gluroo.app.dev.providers.GlucoseRangeDataProviderService"
                primaryProviderType="RANGED_VALUE" />
            <BoundingOval x="0" y="0" width="100" height="100" />

            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="hipo"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] < 70]]></Expression>
                        <Expression name="hiper"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] > 180]]></Expression>
                    </Expressions>
                    <Compare expression="hipo">
                        <Group name="glucosa_hipo" x="0" y="0" width="100" height="100">
                            <Variant mode="AMBIENT" target="alpha" value="170" />
                            <PartDraw x="0" y="0" width="100" height="100">
                                <Arc centerX="50" centerY="50" width="87" height="87" startAngle="0" endAngle="360">
                                    <Stroke color="#ffe5483c" thickness="3" />
                                </Arc>
                            </PartDraw>
                            <PartText x="0" y="22" width="90" height="46">
                                <Text align="CENTER">
                                    <Font family="barlow_condensed_semibold" size="40" color="#ffe5483c">
                                        <Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </Group>
                    </Compare>
                    <Compare expression="hiper">
                        <Group name="glucosa_hiper" x="0" y="0" width="100" height="100">
                            <Variant mode="AMBIENT" target="alpha" value="170" />
                            <PartDraw x="0" y="0" width="100" height="100">
                                <Arc centerX="50" centerY="50" width="87" height="87" startAngle="0" endAngle="360">
                                    <Stroke color="#ffe3a63a" thickness="3" />
                                </Arc>
                            </PartDraw>
                            <PartText x="0" y="22" width="90" height="46">
                                <Text align="CENTER">
                                    <Font family="barlow_condensed_semibold" size="40" color="#ffe3a63a">
                                        <Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </Group>
                    </Compare>
                    <Default>
                        <Group name="glucosa_rango" x="0" y="0" width="100" height="100">
                            <PartDraw x="0" y="0" width="100" height="100">
                                <Variant mode="AMBIENT" target="alpha" value="140" />
                                <Arc centerX="50" centerY="50" width="87" height="87" startAngle="0" endAngle="360">
                                    <Stroke color="#ff1b1b1e" thickness="3" />
                                </Arc>
                                <Arc centerX="50" centerY="50" width="87" height="87" startAngle="0" endAngle="0">
                                    <Transform target="endAngle"
                                        value="clamp(([COMPLICATION.RANGED_VALUE_VALUE] - 70) / 110, 0, 1) * 360" />
                                    <Stroke color="#ffc9a86a" thickness="3" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                            <!-- gold value when active, light grey in ambient (design §5.4) -->
                            <PartText x="0" y="22" width="90" height="46">
                                <Variant mode="AMBIENT" target="alpha" value="0" />
                                <Text align="CENTER">
                                    <Font family="barlow_condensed_semibold" size="40" color="#ffe6cd95">
                                        <Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                            <PartText x="0" y="22" width="90" height="46" alpha="0">
                                <Variant mode="AMBIENT" target="alpha" value="255" />
                                <Text align="CENTER">
                                    <Font family="barlow_condensed_semibold" size="40" color="#ffc8c6c0">
                                        <Template>%s<Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </Group>
                    </Default>
                </Condition>
                <!-- Trend: last character of the provider text ("185→"; seen on the watch 2026-11-23).
                     Empty text, no arrow. -->
                <PartText x="72" y="31" width="20" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#ffefede7">
                            <Template>%s<Parameter expression="subText([COMPLICATION.TEXT], textLength([COMPLICATION.TEXT]) - 1, textLength([COMPLICATION.TEXT]))" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="20" y="67" width="60" height="14">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="barlow_condensed_medium" size="12" color="#ff8c8a84">mg/dL</Font>
                    </Text>
                </PartText>
            </Complication>

            <!-- Only RANGED_VALUE is accepted (2026-11-23): range colours need the value as a number,
                 and on the watch the user picked Gluroo's text-only provider by mistake. -->

            <!-- No data: never a made-up or last-known number (design §5.5) -->
            <Complication type="EMPTY">
                <PartDraw x="0" y="0" width="100" height="100">
                    <Arc centerX="50" centerY="50" width="87" height="87" startAngle="0" endAngle="360">
                        <Stroke color="#ff1b1b1e" thickness="3" />
                    </Arc>
                </PartDraw>
                <PartText x="5" y="22" width="90" height="46">
                    <Text align="CENTER">
                        <Font family="barlow_condensed_semibold" size="40" color="#ff8c8a84">--</Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ===== Hands. Active: 3D gold hands rendered in Blender (art/blender/hands.py, scripts/render_3d.sh).
             Their drop shadows are a second clock shifted 2 px right and 3 px down: shifting the whole
             clock moves every shadow by the same amount whatever the angle, as with a fixed light.
             Ambient: outline hands from art/render_hands.py. Pivot at (233, 233). ===== -->
        <AnalogClock x="2" y="3" width="466" height="466">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <HourHand resource="hand3d_hour_shadow" x="222" y="112" width="22" height="142"
                pivotX="0.5" pivotY="0.852113" />
            <MinuteHand resource="hand3d_minute_shadow" x="224" y="53" width="18" height="205"
                pivotX="0.5" pivotY="0.880488" />
            <SecondHand resource="hand3d_second_shadow" x="224" y="41" width="18" height="235"
                pivotX="0.5" pivotY="0.819149" />
        </AnalogClock>
        <AnalogClock x="0" y="0" width="466" height="466">
            <HourHand resource="hand3d_hour" x="222" y="112" width="22" height="142"
                pivotX="0.5" pivotY="0.852113">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </HourHand>
            <HourHand resource="hand_hour_aod" x="225" y="114" width="16" height="137"
                pivotX="0.5" pivotY="0.868613" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
            </HourHand>
            <MinuteHand resource="hand3d_minute" x="224" y="53" width="18" height="205"
                pivotX="0.5" pivotY="0.880488">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </MinuteHand>
            <MinuteHand resource="hand_minute_aod" x="227" y="54" width="12" height="201"
                pivotX="0.5" pivotY="0.890547" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
            </MinuteHand>
            <SecondHand resource="hand3d_second" x="224" y="41" width="18" height="235"
                pivotX="0.5" pivotY="0.819149">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </SecondHand>
        </AnalogClock>
        <PartImage name="tapa_sombra" x="222" y="224" width="24" height="23">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="hand3d_cap_shadow" />
        </PartImage>
        <PartImage name="tapa" x="221" y="222" width="24" height="23">
            <Image resource="hand3d_cap" />
        </PartImage>

    </Scene>
</WatchFace>
